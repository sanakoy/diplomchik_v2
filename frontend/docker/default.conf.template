# Шаблон: ${BACKEND_URL} подставляется при старте контейнера (envsubst).
# Переменные nginx вида $host не трогаются: у них нет фигурных скобок
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Версию nginx в ответах и страницах ошибок не показываем
    server_tokens off;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # API — на тот же адрес, что и фронт: браузеру не нужен CORS, а
    # refresh-cookie с Path=/api/v1/auth работает без настроек, как и с Vite
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        # Настоящий адрес клиента: по нему бэк ограничивает попытки входа.
        # Без этого все запросы пришли бы с адреса nginx, и лимит по IP
        # стал бы общим на всех пользователей.
        # Именно $remote_addr, а не $proxy_add_x_forwarded_for: тот дописывает
        # адрес к заголовку, присланному клиентом, и клиент подставлял бы
        # любой IP — лимит попыток входа обходился бы. nginx здесь первым
        # принимает запрос, поэтому чужой X-Forwarded-For он не доверяет.
        # Если перед ним появится балансировщик — нужен модуль realip
        # с адресом балансировщика в set_real_ip_from
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Файлы сборки с хешем в имени (index-B7gkens-.js): содержимое по имени
    # не меняется никогда, поэтому кешируем на год
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        # Именно 404, а не index.html: если после деплоя вкладка просит старый
        # чанк, import() должен упасть — тогда React Router покажет «Обновите страницу»,
        # а не получит HTML вместо JavaScript
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        # index.html не кешируем: после деплоя браузер сразу получит новые
        # имена файлов сборки
        add_header Cache-Control "no-cache" always;
        # Приложение одностраничное: /statistics и другие пути — это index.html,
        # маршрут разбирает React Router. Иначе обновление страницы давало бы 404
        try_files $uri /index.html;
    }
}
